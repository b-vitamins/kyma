{
  "batch_size": 8,
  "max_steps": 100000,
  "grad_accum_steps": 1,
  "precision": "fp32",
  "grad_clip_norm": 1.0,
  "log_every_steps": 10,
  "checkpoint_every_steps": 1000,
  "device": "cuda",
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-08
  },
  "schedule": {
    "warmup_steps": 2000,
    "min_lr_scale": 0.1
  }
}
