# Copy this file to `.env` and fill in the machines you want the repo scripts to
# manage.
#
# Machine names are free-form at the interface level (`dev-box`, `builder`,
# `cluster-a`), but their per-machine variables are stored under a normalized
# upper-case prefix where `-` and `.` become `_`.
#
# For example:
#   machine name: dev-box
#   variable prefix: KD_REMOTE_DEV_BOX_
#
# Supported auth modes:
# - `key`: prefer SSH public-key auth and fall back to password when `PASSWORD`
#   is also set
# - `password`: force password auth through `sshpass`

KD_REMOTE_MACHINES=dev-box
KD_REMOTE_DEFAULT_MACHINE=dev-box

KD_REMOTE_DEV_BOX_HOST=dev.example.com
KD_REMOTE_DEV_BOX_USER=your-username
KD_REMOTE_DEV_BOX_PORT=22
# Optional but recommended. If omitted, remote-shell starts in the server's
# default login directory and rsync needs explicit --dest/--source paths.
KD_REMOTE_DEV_BOX_WORKDIR=/srv/project
KD_REMOTE_DEV_BOX_AUTH=key
KD_REMOTE_DEV_BOX_SSH_KEY=/home/you/.ssh/id_ed25519
# Optional password fallback while keys are being rolled out.
KD_REMOTE_DEV_BOX_PASSWORD=replace-me

# Example password-auth machine:
#
# KD_REMOTE_MACHINES=dev-box,archive-box
# KD_REMOTE_ARCHIVE_BOX_HOST=archive.example.com
# KD_REMOTE_ARCHIVE_BOX_USER=your-username
# KD_REMOTE_ARCHIVE_BOX_PORT=22
# KD_REMOTE_ARCHIVE_BOX_WORKDIR=/srv/archive/project
# KD_REMOTE_ARCHIVE_BOX_AUTH=password
# KD_REMOTE_ARCHIVE_BOX_PASSWORD=replace-me
